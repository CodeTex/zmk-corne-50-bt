#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    macros {
        vim_w: vim_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp RET>;
            label = "VIM_W";
        };

        vim_q: vim_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp Q &kp RET>;
            label = "VIM_Q";
        };

        bt_0: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &bt BT_SEL 0 &rgb_ug RGB_COLOR_HSB(112,100,50)>;
            label = "NEW_MACRO";
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &bt BT_SEL 1 &rgb_ug RGB_COLOR_HSB(193,100,50)>;
            label = "BT_1";
        };

        bt_2: bg_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &bt BT_SEL 2 &rgb_ug RGB_COLOR_HSB(50,100,50)>;
            label = "BG_2";
        };

        bt_3: bg_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &bt BT_SEL 3 &rgb_ug RGB_COLOR_HSB(0,100,50)>;
            label = "BG_3";
        };

        bt_4: bg_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &bt BT_SEL 4 &rgb_ug RGB_COLOR_HSB(275,100,50)>;
            label = "BG_4";
        };

        bt_clr: bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_OFF &rgb_ug RGB_ON &bt BT_CLR &rgb_ug RGB_COLOR_HSB(275,0,100)>;
            label = "BT_CLR";
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <40 41 42 7 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45 7 8 9 10 11 12 13 22 23 24 25 26 27>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <43 44 45 14 15 16 17 18 19 28 29 30 31 32 33 40 41 42 0 1 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42 2 3 4>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        tg_game {
            bindings = <&caps_word>;
            key-positions = <14 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&none       &kp Q        &kp W            &kp E                 &kp R                &kp T      &none              &none            &kp Y      &kp U                 &kp I                   &kp O             &kp P           &none
&kp ESCAPE  &hml LGUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT D     &hml LEFT_CONTROL F  &kp G      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp H      &hmr RIGHT_CONTROL J  &hmr RIGHT_SHIFT K      &hmr RIGHT_ALT L  &hmr RGUI SEMI  &kp SQT
&kp DEL     &kp Z        &kp X            &kp C                 &kp V                &kp B                                          &kp N      &kp M                 &kp COMMA               &kp DOT           &kp FSLH        &kp BACKSPACE
                                          &mt LEFT_SHIFT ENTER  &lt 1 SPACE          &lt 3 TAB                                      &lt 4 RET  &lt 2 BACKSPACE       &mt RIGHT_SHIFT DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        sym {
            bindings = <
&none  &none        &kp DOLLAR  &kp AMPERSAND  &kp ASTRK  &none  &kp CAPSLOCK  &caps_word  &none          &kp TILDE         &kp LEFT_BRACE        &kp RIGHT_BRACE        &none      &none
&none  &kp AT_SIGN  &kp GRAVE   &kp HASH       &kp PLUS   &none  &none         &none       &none          &kp MINUS         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &none
&none  &kp EXCL     &kp CARET   &kp PERCENT    &kp PIPE   &none                            &none          &kp UNDERSCORE    &kp LBKT              &kp RBKT               &kp BSLH   &none
                                &none          &none      &none                            &kp LESS_THAN  &kp GREATER_THAN  &none
            >;
        };

        nav {
            bindings = <
&none   &none  &none  &none  &none      &none  &kp PRINTSCREEN  &kp INS  &none  &none           &none           &none         &none            &none
&none   &kp A  &kp S  &kp D  &kp F      &none  &none            &none    &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&vim_q  &none  &none  &none  &none      &none                            &none  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &vim_w
                      &none  &kp SPACE  &none                            &none  &none           &none
            >;
        };

        num {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none  &to 5  &none  &kp ASTRK  &kp N7  &kp N8  &kp N9  &none      &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none  &none  &none  &kp PLUS   &kp N4  &kp N5  &kp N6  &none      &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &none                &kp MINUS  &kp N1  &kp N2  &kp N3  &kp SLASH  &to 0
                        &none    &none    &none                &kp DOT    &kp N0  &none
            >;
        };

        util {
            bindings = <
&none    &bootloader  &none       &studio_unlock  &none       &sys_reset       &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &sys_reset  &mkp MB1        &mkp MB2        &mkp MB3      &none            &none
&none    &kp C_PREV   &kp C_MUTE  &kp C_PP        &kp C_NEXT  &none            &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &none       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&bt_clr  &bt_0        &bt_1       &bt_2           &bt_3       &bt_4                                              &none       &mkp MB4        &msc SCRL_DOWN  &msc SCRL_UP  &mkp MB5         &to 3
                                  &kp SCROLLLOCK  &none       &rgb_ug RGB_TOG                                    &none       &none           &none
            >;
        };

        game {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R     &kp T      &trans   &to 0     &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D     &kp F     &kp G      &kp ESC  &kp APOS  &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LALT   &kp Z  &kp X  &kp C     &kp V     &kp B                         &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                         &kp LALT  &kp LGUI  &kp SPACE                     &kp SPACE  &kp RGUI  &kp RALT
            >;
        };
    };
};
